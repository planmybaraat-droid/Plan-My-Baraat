# Required for CRM authentication and database functionality.
NEXT_PUBLIC_SITE_URL=https://planmybaraat.com
NEXT_PUBLIC_SUPABASE_URL=
# Set either the publishable key below or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Admin > Staff account creation (server-only, NEVER expose this
# to the browser — do not prefix it with NEXT_PUBLIC_). Find it in
# Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Required for the automatic Daily Staff Report email (Settings > Daily Staff
# Email report). Works with any standard SMTP mailbox — configured here for
# a Hostinger-hosted business email (e.g. care@planmybaraat.com), but Gmail
# or any other provider's SMTP works the same way, just with a different
# host/port. SMTP_USER/SMTP_PASSWORD are the mailbox's own login and password
# (for Hostinger, the normal email password works — no app-specific password
# needed like Gmail requires). SMTP_FROM_NAME is optional and only changes
# the display name the recipient sees (e.g. "PlanMyBaraat CRM").
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=PlanMyBaraat CRM

# Optional: add the Meta Pixel ID when tracking is enabled.
NEXT_PUBLIC_META_PIXEL_ID=
