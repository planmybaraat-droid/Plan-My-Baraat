# Required for CRM authentication and database functionality.
NEXT_PUBLIC_SITE_URL=https://planmybaraat.com
NEXT_PUBLIC_SUPABASE_URL=
# Set either the publishable key below or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Admin > Staff account creation (server-only, NEVER expose this
# to the browser — do not prefix it with NEXT_PUBLIC_). Find it in
# Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: add the Meta Pixel ID when tracking is enabled.
NEXT_PUBLIC_META_PIXEL_ID=
